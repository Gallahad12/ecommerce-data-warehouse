# Copy to .env and fill in your own values. Never commit .env or the key file.
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
BQ_LOCATION=US
BQ_RAW_DATASET=olist_raw
BQ_DW_DATASET=olist_dw

# Optional: a Slack-compatible webhook that receives pipeline failure alerts.
ALERT_WEBHOOK_URL=

# Linux only: set to the output of `id -u`. Leave as 50000 on Windows and macOS.
AIRFLOW_UID=50000
